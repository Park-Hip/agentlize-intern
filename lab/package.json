{
  "name": "agentlize-lab",
  "version": "0.0.0",
  "private": true,
  "description": "AI Operations Connector Lab: gateway, fake systems, MCP adapter and tests",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "shared",
    "gateway",
    "mcp-adapter",
    "fake-directory",
    "fake-tasks",
    "tests"
  ],
  "scripts": {
    "build": "npm run build:shared && npm run build:fake-directory && npm run build:fake-tasks && npm run build:gateway && npm run build:mcp-adapter && npm run build:tests && npm run build:scripts",
    "build:shared": "npm run build -w @lab/shared",
    "build:gateway": "npm run build -w @lab/gateway",
    "build:mcp-adapter": "npm run build -w @lab/mcp-adapter",
    "build:fake-directory": "npm run build -w @lab/fake-directory",
    "build:fake-tasks": "npm run build -w @lab/fake-tasks",
    "build:tests": "npm run build -w @lab/tests",
    "build:scripts": "tsc -p tsconfig-scripts.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"shared/dist/**/*-test.js\" \"gateway/dist/**/*-test.js\" \"fake-directory/dist/**/*-test.js\" \"fake-tasks/dist/**/*-test.js\" \"mcp-adapter/dist/**/*-test.js\" \"tests/dist/**/*-test.js\"",
    "start": "npm run build && node dist/scripts/start.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-sqlite3": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
