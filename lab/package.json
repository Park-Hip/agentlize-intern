{
  "name": "agentlize-lab",
  "version": "0.0.0",
  "private": true,
  "description": "AI Operations Connector Lab: gateway, fake systems, operator console, MCP adapter and tests",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "shared",
    "gateway",
    "fake-directory",
    "fake-tasks",
    "console",
    "tests",
    "measure",
    "assistants"
  ],
  "scripts": {
    "build": "npm run build:shared && npm run build:fake-directory && npm run build:fake-tasks && npm run build:gateway && npm run build:console && npm run build:tests && npm run build:measure && npm run build:assistants && npm run build:scripts",
    "build:shared": "npm run build -w @lab/shared",
    "build:gateway": "npm run build -w @lab/gateway",
    "build:fake-directory": "npm run build -w @lab/fake-directory",
    "build:fake-tasks": "npm run build -w @lab/fake-tasks",
    "build:console": "npm run build -w @lab/console",
    "build:tests": "npm run build -w @lab/tests",
    "build:measure": "npm run build -w @lab/measure",
    "build:assistants": "npm run build -w @lab/assistants",
    "build:scripts": "tsc -p tsconfig-scripts.json",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p assistants/tsconfig-lint.json",
    "test": "npm run build && node --test \"shared/dist/**/*-test.js\" \"gateway/dist/**/*-test.js\" \"fake-directory/dist/**/*-test.js\" \"fake-tasks/dist/**/*-test.js\" \"console/dist/**/*-test.js\" \"tests/dist/**/*-test.js\" \"measure/dist/**/*-test.js\" \"assistants/dist/**/*-test.js\" \"dist/scripts/**/*-test.js\"",
    "start": "npm run build && node dist/scripts/start.js",
    "tunnel": "npm run build && node dist/scripts/tunnel.js",
    "keys": "npm run build:shared && npm run build:gateway && node gateway/dist/cli/keys-main.js",
    "seed-keys": "npm run build:shared && npm run build:gateway && node gateway/dist/cli/seed-keys-main.js",
    "trace": "npm run build:shared && npm run build:gateway && node gateway/dist/cli/trace-main.js",
    "measure": "npm run build && node measure/dist/cli.js",
    "assistant": "npm run build && node assistants/dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-sqlite3": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
