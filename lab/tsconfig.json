{
  "extends": "./tsconfig-base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@lab/gateway": ["./gateway/src/lib.ts"],
      "@lab/shared": ["./shared/src/index.ts"],
      "@lab/tests/doors": ["./tests/src/doors.ts"],
      "@lab/tests/process": ["./tests/src/process.ts"]
    }
  },
  "include": [
    "shared/src/**/*.ts",
    "gateway/src/**/*.ts",
    "fake-directory/src/**/*.ts",
    "fake-tasks/src/**/*.ts",
    "console/src/**/*.ts",
    "tests/src/**/*.ts",
    "measure/src/**/*.ts",
    "scripts/**/*.ts"
  ]
}
