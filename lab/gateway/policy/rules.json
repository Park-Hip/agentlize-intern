{
  "schema": 2,
  "version": 1,
  "approval": {
    "approver_roles": ["lead"],
    "same_department": true,
    "wait_minutes": 120
  },
  "cumulative_window_minutes": 60,
  "clients": {
    "tho-than-desktop": { "class": "appota_hosted", "ceiling": "employee_personal" },
    "tho-than-web": { "class": "appota_hosted", "ceiling": "employee_personal" },
    "fc-assistant": { "class": "appota_hosted", "ceiling": "employee_personal" },
    "lab-console": { "class": "appota_hosted", "ceiling": "employee_personal" },
    "test": { "class": "appota_hosted", "ceiling": "employee_personal" },
    "user_device": { "class": "user_device", "ceiling": "internal_general" }
  },
  "resources": {
    "task": {
      "bulk_threshold": 5,
      "read": {
        "intern": "own_department",
        "staff": "own_department",
        "lead": "own_department",
        "hr": "own_department"
      },
      "fields": {
        "intern": ["id", "title", "description", "department", "assignee", "status", "due"],
        "staff": ["id", "title", "description", "department", "assignee", "status", "due"],
        "lead": ["id", "title", "description", "department", "assignee", "status", "due"],
        "hr": ["id", "title", "description", "department", "assignee", "status", "due"]
      },
      "data_classes": {
        "id": "internal_general",
        "title": "internal_general",
        "description": "internal_general",
        "department": "internal_general",
        "assignee": "internal_general",
        "status": "internal_general",
        "due": "internal_general",
        "version": "internal_general"
      },
      "actions": {
        "edit_task_description": {
          "intern": { "effect": "allow", "scope": "own_department", "bulk": "deny" },
          "staff": { "effect": "allow", "scope": "own_department", "bulk": "needs_approval" },
          "lead": { "effect": "allow", "scope": "own_department", "bulk": "allow" },
          "hr": { "effect": "allow", "scope": "own_department", "bulk": "needs_approval" }
        },
        "change_task_status": {
          "intern": { "effect": "allow", "scope": "own_department", "bulk": "deny" },
          "staff": { "effect": "allow", "scope": "own_department", "bulk": "needs_approval" },
          "lead": { "effect": "allow", "scope": "own_department", "bulk": "allow" },
          "hr": { "effect": "allow", "scope": "own_department", "bulk": "needs_approval" }
        },
        "change_task_assignee_or_due": {
          "intern": { "effect": "deny", "scope": "own_department", "bulk": "deny" },
          "staff": { "effect": "allow", "scope": "own_department", "bulk": "needs_approval" },
          "lead": { "effect": "allow", "scope": "own_department", "bulk": "allow" },
          "hr": { "effect": "allow", "scope": "own_department", "bulk": "needs_approval" }
        }
      }
    },
    "employee": {
      "bulk_threshold": 5,
      "read": {
        "intern": "any",
        "staff": "any",
        "lead": "any",
        "hr": "any"
      },
      "fields": {
        "intern": ["id", "name", "department", "role", "work_email"],
        "staff": ["id", "name", "department", "role", "work_email"],
        "lead": ["id", "name", "department", "role", "work_email"],
        "hr": ["id", "name", "department", "role", "work_email", "personal_phone", "home_address"]
      },
      "data_classes": {
        "id": "internal_general",
        "name": "internal_general",
        "department": "internal_general",
        "role": "internal_general",
        "work_email": "internal_general",
        "personal_phone": "employee_personal",
        "home_address": "employee_personal"
      },
      "actions": {
        "edit_work_email": {
          "intern": { "effect": "deny", "scope": "any" },
          "staff": { "effect": "deny", "scope": "any" },
          "lead": { "effect": "deny", "scope": "any" },
          "hr": { "effect": "allow", "scope": "any" }
        }
      }
    }
  }
}
